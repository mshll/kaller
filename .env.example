# Kaller Configuration
# Search uses the public version 55 Firebase Storage configuration.
# No environment variables are required for the primary connection.

# Optional existing encrypted search backup (server only)
AES_KEY=your_existing_aes_key

# Encrypted backup configuration; also used by verification and blocking tools
FIREBASE_URL=https://your-firebase-db.firebaseio.com

# Server port (optional)
PORT=3000
